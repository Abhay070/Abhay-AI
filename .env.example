# ===========================================================================
# PRESETS — copy one of these three blocks over the settings below.
#
# The storage question decides which. A model that runs on YOUR machine costs
# the user disk space and RAM; a model that runs on someone's server costs
# them nothing. That is the whole reason a hosted assistant never asks you to
# download anything — the weights are not on your device.
#
# So: local is the PRIVACY option. Hosted is the PUBLIC option. Pick per
# deployment, not per preference.
# ===========================================================================
#
# --- 1. PUBLIC RELEASE — zero download for your users ----------------------
# You hold one key. Visitors need no account, no install, no disk space. This
# is how a hosted assistant works, and the only sane public configuration.
#   PROVIDER=groq
#   GROQ_API_KEY=<your key>
#   GROQ_MODEL=llama-3.3-70b-versatile
#   FALLBACK_CHAIN=gemini,demo
#   DEFAULT_STRATEGY=single
# Your users download 0 bytes of model. Nothing is stored on their machine.
#
# --- 2. PRIVATE — nothing leaves your computer -----------------------------
# Costs disk (2-9 GB) and RAM, gains total privacy and offline use.
#   PROVIDER=ollama
#   OLLAMA_MODEL=qwen2.5:14b
#   FALLBACK_CHAIN=demo
#
# --- 3. BEST ANSWERS — several models, best one wins -----------------------
# Slower and N times the calls, noticeably better on hard questions.
#   PROVIDER=groq
#   DEFAULT_STRATEGY=council
#   COUNCIL_MEMBERS=groq:llama-3.3-70b-versatile,gemini:gemini-2.0-flash
#   COUNCIL_JUDGE=groq:llama-3.3-70b-versatile
#
# ===========================================================================

# Praxis configuration. Copy to .env and edit:  cp .env.example .env
# .env is gitignored. Never commit real keys.

# ---------------------------------------------------------------------------
# BRAIN — which model answers.
#   demo       works with zero setup (scripted, not a real model)
#   ollama     free, local, offline, private          ← recommended
#   groq       free tier, hosted, very fast
#   gemini     free tier
#   openai     any OpenAI-compatible endpoint
#   anthropic  Claude (paid)
#   scratch    the model you trained in scratch/
# ---------------------------------------------------------------------------
PROVIDER=demo

# Tried in order if the primary is unreachable. A local model going down
# should degrade, not kill the assistant.
FALLBACK_CHAIN=ollama,groq,demo

# --- ollama: install from https://ollama.com, then `ollama pull llama3.2` ---
OLLAMA_MODEL=llama3.2
OLLAMA_HOST=http://localhost:11434

# --- groq: free key, no card, at https://console.groq.com -------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- gemini: free key at https://aistudio.google.com/apikey -----------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- any OpenAI-compatible server: LM Studio, vLLM, OpenRouter, Together ----
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- claude: paid. pip install anthropic ------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# IDENTITY
# ---------------------------------------------------------------------------
BRAND_NAME=Praxis
BRAND_TAGLINE=Think. Challenge. Build. Verify. Execute.
BRAND_OWNER=Abhay
USER_NAME=

# Which mode a new conversation starts in.
DEFAULT_MODE=standard

# ---------------------------------------------------------------------------
# CAPABILITIES
# ---------------------------------------------------------------------------
ENABLE_TOOLS=true
ENABLE_MEMORY=true
ENABLE_WEB=true

# OFF BY DEFAULT, DELIBERATELY. This executes model-written Python on this
# machine. The isolation is a subprocess and a timeout — not a real sandbox.
# Read praxis/tools/code.py before turning it on.
ENABLE_CODE_EXEC=false
CODE_EXEC_TIMEOUT=10

# Search backend: duckduckgo (free, no key) | brave | tavily | searxng
SEARCH_BACKEND=duckduckgo
BRAVE_API_KEY=
TAVILY_API_KEY=
SEARXNG_URL=

# ---------------------------------------------------------------------------
# THE COUNCIL — several models answer, the best answer wins
# ---------------------------------------------------------------------------
# single  | council | race | cascade   (see praxis/council.py)
DEFAULT_STRATEGY=single

# Members are "backend:model", comma separated. Unreachable ones are dropped
# with the reason shown, so listing a local model beside hosted ones is safe.
COUNCIL_MEMBERS=groq:llama-3.3-70b-versatile,gemini:gemini-2.0-flash,ollama:llama3.2

# Who arbitrates. Empty falls back to a stated heuristic rather than a coin flip.
COUNCIL_JUDGE=

COUNCIL_TIMEOUT=90

# Cascade escalates to this when the cheap model's answer looks weak.
CASCADE_STRONG=groq:llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# LIMITS
# ---------------------------------------------------------------------------
MAX_HISTORY=24
MAX_TOOL_ROUNDS=6

HOST=127.0.0.1
PORT=8000
