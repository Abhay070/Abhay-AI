# Copy this to .env in the project root and edit.
#   cp app/.env.example .env
# .env is gitignored -- never commit real keys.

# Which brain to use: ollama | groq | gemini | scratch
PROVIDER=ollama

# --- ollama: free, local, offline, no key -----------------------------------
# Install from https://ollama.com then: ollama pull llama3.2
OLLAMA_MODEL=llama3.2
OLLAMA_HOST=http://localhost:11434

# --- groq: free tier, hosted, very fast -------------------------------------
# Free key (no card) at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- gemini: free tier -------------------------------------------------------
# Free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- your own model from scratch/ -------------------------------------------
# No configuration. Train it first: python scratch/train.py

# Your assistant's personality. Change this and you change who it is.
SYSTEM_PROMPT=You are Abhay-AI, a helpful and direct assistant. You give concrete, specific answers and admit when you do not know something. You never pad your responses with filler.

# How many past turns to resend with each request.
MAX_HISTORY=20
